{
  // Same formatter for every file type in this repo (Prettier, config in package.json)
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // Format on save, but only the lines you changed (git diff), never the whole file
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "modificationsIfAvailable",

  // Only format when the project has a Prettier config, using the project's prettier version
  "prettier.requireConfig": true,
  "prettier.resolveGlobalModules": false,

  // Keep each file's existing line endings
  "files.eol": "auto"
}
