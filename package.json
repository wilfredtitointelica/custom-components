{
  "name": "custom-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-docs.mjs --watch -- ng serve",
    "docs": "node scripts/generate-docs.mjs",
    "new:variant": "node scripts/new-variant.mjs",
    "new:version": "node scripts/new-version.mjs",
    "set:status": "node scripts/set-status.mjs",
    "order:variants": "node scripts/order-variants.mjs",
    "remove": "node scripts/remove.mjs",
    "rename": "node scripts/rename.mjs",
    "visibility": "node scripts/visibility.mjs",
    "prebuild": "npm run docs",
    "build": "ng build",
    "watch": "node scripts/generate-docs.mjs --watch -- ng build --watch --configuration development",
    "pretest": "npm run docs",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^1.2.5",
    "primeicons": "^8.0.2",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
