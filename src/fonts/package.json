{
  "name": "incontrol-fonts",
  "version": "1.0.0",
  "private": true,
  "description": "Generador de fuentes de iconos a partir de SVG (fantasticon).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:incontrol-icons",
    "build:incontrol-icons": "node scripts/build-icons.mjs incontrol-icons",
    "postinstall": "patch-package"
  },
  "devDependencies": {
